rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    function isLoggedIn() {
      return request.auth != null;
    }


    function isAdmin() {
      return isLoggedIn()
        && request.auth.token.email == "vikramshakyawal99@gmail.com";
    }



    // =========================
    // PROPERTIES
    // =========================

    match /properties/{propertyId} {


      // Public property listing
      allow read: if true;


      // Owner can create only own property
      allow create: if isLoggedIn()
        && request.resource.data.ownerId == request.auth.uid;


      // Owner or Admin update
      allow update: if isAdmin()
        || (
          isLoggedIn()
          && resource.data.ownerId == request.auth.uid
        );


      // Owner or Admin delete
      allow delete: if isAdmin()
        || (
          isLoggedIn()
          && resource.data.ownerId == request.auth.uid
        );

    }





    // =========================
    // LEADS
    // =========================

    match /leads/{leadId} {


      // Customer enquiry
      allow create: if true;


      // Admin or own owner leads
      allow read: if isAdmin()
        || (
          isLoggedIn()
          && resource.data.ownerId == request.auth.uid
        );


      // Admin or owner update
      allow update: if isAdmin()
        || (
          isLoggedIn()
          && resource.data.ownerId == request.auth.uid
        );


      allow delete: if isAdmin();

    }





    // =========================
    // SITE VISITS
    // =========================

    match /siteVisits/{visitId} {


      // Customer booking
      allow create: if true;


      // Admin or owner own visits
      allow read: if isAdmin()
        || (
          isLoggedIn()
          && resource.data.ownerId == request.auth.uid
        );


      // Admin or owner update status
      allow update: if isAdmin()
        || (
          isLoggedIn()
          && resource.data.ownerId == request.auth.uid
        );


      allow delete: if isAdmin();

    }





    // =========================
    // PROPERTY VIEWS
    // =========================

    match /propertyViews/{viewId} {

      allow read: if true;

      allow write: if true;

    }





    // =========================
    // USERS
    // =========================

    match /users/{userId} {


      allow read: if isLoggedIn();


      allow create: if isLoggedIn();


      allow update: if isAdmin()
        || (
          isLoggedIn()
          && request.auth.uid == userId
        );


      allow delete: if isAdmin();

    }





    // =========================
    // NOTIFICATIONS
    // =========================

    match /notifications/{notificationId} {


      // Owner reads own notification
      allow read: if isAdmin()
        || (
          isLoggedIn()
          && resource.data.ownerId == request.auth.uid
        );


      // Admin or logged user create
      allow create: if isLoggedIn();


      // Owner mark read
      allow update: if isAdmin()
        || (
          isLoggedIn()
          && resource.data.ownerId == request.auth.uid
        );


      allow delete: if isAdmin();

    }





    // =========================
    // DEFAULT BLOCK
    // =========================

    match /{document=**} {

      allow read, write: if false;

    }


  }

}
