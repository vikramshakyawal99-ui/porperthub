rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =========================
    // AUTH HELPERS
    // =========================

    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isLoggedIn()
        && request.auth.token.role == "admin";
    }

    function isOwnerRole() {
      return isLoggedIn()
        &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role in [
                    "buyer",
"property_owner",
          "hostel_owner",
          "pg_owner",
          "room_owner",
          "resale_seller"
        ];
    }

    function isDealer() {
      return isLoggedIn()
        &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "property_dealer";
    }

    function isTeamMember() {
      return isLoggedIn()
        &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "team_member";
    }


    // =========================
    // PROPERTIES
    // =========================

    match /properties/{propertyId} {

      allow read: if true;

      allow create: if isAdmin()
        ||
        (
          isOwnerRole()
          && request.resource.data.ownerId == request.auth.uid
        )
        ||
        (
          isDealer()
          && request.resource.data.dealerId == request.auth.uid
        )
        ||
        (
          isTeamMember()
          && request.resource.data.addedByUid == request.auth.uid
          && request.resource.data.addedByRole == "team_member"
          && request.resource.data.source == "propertyhub_team"
          && request.resource.data.status == "pending"
          && request.resource.data.featured == false
        );

      allow update, delete: if isAdmin()
        ||
        (
          isLoggedIn()
          && resource.data.ownerId == request.auth.uid
        )
        ||
        (
          isDealer()
          && resource.data.dealerId == request.auth.uid
        );
    }


    // =========================
    // LEADS
    // =========================

    match /leads/{leadId} {

      allow create: if isLoggedIn();

      allow read, update: if isAdmin()
        ||
        (
          isLoggedIn()
          &&
          (
            resource.data.ownerId == request.auth.uid ||
            resource.data.buyerId == request.auth.uid
          )
        )
        ||
        (
          isDealer()
          && resource.data.dealerId == request.auth.uid
        );

      allow delete: if isAdmin();
    }


    // =========================
    // SITE VISITS
    // =========================

    match /siteVisits/{visitId} {

      allow create: if isLoggedIn();

      allow read, update: if isAdmin()
        ||
        (
          isLoggedIn()
          &&
          (
            resource.data.ownerId == request.auth.uid ||
            resource.data.buyerId == request.auth.uid
          )
        )
        ||
        (
          isDealer()
          && resource.data.dealerId == request.auth.uid
        );

      allow delete: if isAdmin();
    }


    // =========================
    // PROPERTY VIEWS
    // =========================

    match /propertyViews/{viewId} {

      allow read: if true;

      allow create: if isLoggedIn()
        && request.resource.data.propertyId == viewId
        && request.resource.data.views == 1;

      allow update: if isLoggedIn()
        && resource.data.propertyId == viewId
        && request.resource.data.propertyId == resource.data.propertyId
        && request.resource.data.views == resource.data.views + 1;

      allow delete: if false;
    }


    // =========================
    // USERS
    // =========================

    match /users/{userId} {

      // User can read own profile.
      // Admin can read all profiles.
      allow read: if isAdmin()
        ||
        (
          isLoggedIn()
          && request.auth.uid == userId
        );

      // New users can create only their own profile.
      // Self-registration is limited to non-admin application roles.
      allow create: if isLoggedIn()
        && request.auth.uid == userId
        && request.resource.data.role in [
          "buyer",
          "property_owner",
          "hostel_owner",
          "pg_owner",
          "room_owner",
          "resale_seller",
          "property_dealer"
        ];

      // Admin can change anything.
      // Normal user can update own profile,
      // but CANNOT change their role.
      allow update: if isAdmin()
        ||
        (
          isLoggedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
        );

      allow delete: if isAdmin();

  // =========================
  // USER FAVORITES
  // =========================

  match /favorites/{propertyId} {

    allow read, create, delete: if isLoggedIn()
      && request.auth.uid == userId;
  }
    }


    // =========================
    // NOTIFICATIONS
    // =========================

    match /notifications/{notificationId} {

      allow read: if isAdmin()
        ||
        (
          isLoggedIn()
          &&
          (
            resource.data.ownerId == request.auth.uid ||
            resource.data.buyerId == request.auth.uid ||
            resource.data.dealerId == request.auth.uid
          )
        );

      allow create: if isLoggedIn();

      allow update: if isAdmin()
        ||
        (
          isLoggedIn()
          &&
          (
            resource.data.ownerId == request.auth.uid ||
            resource.data.dealerId == request.auth.uid
          )
        );

      allow delete: if isAdmin();
    }


    // =========================
    // WISHLIST
    // =========================

    match /wishlist/{wishlistId} {

      allow read: if isLoggedIn()
        && resource.data.buyerId == request.auth.uid;

      allow create: if isLoggedIn()
        && request.auth.uid == request.resource.data.buyerId;

      allow delete: if isLoggedIn()
        && resource.data.buyerId == request.auth.uid;
    }


    // =========================
    // LOAN APPLICATIONS
    // =========================

    match /loanApplications/{applicationId} {

      // Customer can submit a new loan requirement.
      // Partner, sanction, disbursement and commission fields
      // are locked to their initial values at creation.
      allow create: if
        request.resource.data.status == "new"
        && request.resource.data.source == "propertyhub"
        && request.resource.data.partnerId == ""
        && request.resource.data.partnerName == ""
        && request.resource.data.externalApplicationId == ""
        && request.resource.data.sanctionedAmount == 0
        && request.resource.data.disbursedAmount == 0
        && request.resource.data.commissionPercent == 0
        && request.resource.data.commissionAmount == 0
        && request.resource.data.commissionStatus == "not_connected"
        && request.resource.data.customerName is string
        && request.resource.data.customerPhone is string
        && request.resource.data.requiredLoanAmount is number
        && request.resource.data.estimatedEligibleAmount is number;

      allow read: if isAdmin()
        ||
        (
          isLoggedIn()
          && resource.data.buyerId == request.auth.uid
        );

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // =========================
    // HOMEPAGE SPONSORED ADS
    // =========================

    match /homepageAds/{adId} {

      // Public users may only read active campaigns.
      // Admin and PropertyHub team can manage all campaigns.
      allow read: if isAdmin()
        || isTeamMember()
        || resource.data.active == true;

      allow create, update, delete:
        if isAdmin() || isTeamMember();
    }


    // =========================
    // DEFAULT DENY
    // =========================

    
// =========================
// FAVORITES
// =========================


match /{document=**} {
      allow read, write: if false;
    }
  }
}
