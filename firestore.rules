rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    function isLoggedIn() {
      return request.auth != null;
    }


    function isAdmin() {
      return isLoggedIn()
        && request.auth.token.role == "admin";
    }


    function isOwnerRole() {
      return isLoggedIn()
      &&
      (
        request.auth.token.role == "property_owner" ||
        request.auth.token.role == "hostel_owner" ||
        request.auth.token.role == "pg_owner" ||
        request.auth.token.role == "room_owner" ||
        request.auth.token.role == "resale_seller"
      );
    }



    // =========================
    // PROPERTIES
    // =========================

    match /properties/{propertyId} {

      allow read: if true;


      allow create: if isAdmin() || (
        isOwnerRole()
        &&
        request.resource.data.ownerId == request.auth.uid
      );


      allow update, delete: if isAdmin()
      ||
      (
        isLoggedIn()
        &&
        resource.data.ownerId == request.auth.uid
      );

    }



    // =========================
    // LEADS
    // =========================

    match /leads/{leadId} {

      allow create: if isLoggedIn();


      allow read, update: if isAdmin()
      ||
      (
        isLoggedIn()
        &&
        (
          resource.data.ownerId == request.auth.uid
          ||
          resource.data.buyerId == request.auth.uid
        )
      );


      allow delete: if isAdmin();

    }




    // =========================
    // SITE VISITS
    // =========================

    match /siteVisits/{visitId} {

      allow create: if isLoggedIn();


      allow read, update: if isAdmin()
      ||
      (
        isLoggedIn()
        &&
        (
          resource.data.ownerId == request.auth.uid
          ||
          resource.data.buyerId == request.auth.uid
        )
      );


      allow delete: if isAdmin();

    }




    // =========================
    // PROPERTY VIEWS
    // =========================

    match /propertyViews/{viewId} {

      allow read: if true;


      allow create: if isLoggedIn();


      allow update, delete: if false;

    }




    // =========================
    // USERS
    // =========================

    match /users/{userId} {


      allow read: if isAdmin()
      ||
      (
        isLoggedIn()
        &&
        request.auth.uid == userId
      );


      allow create: if isLoggedIn();


      allow update: if isAdmin()
      ||
      (
        isLoggedIn()
        &&
        request.auth.uid == userId
      );


      allow delete: if isAdmin();

    }





    // =========================
    // NOTIFICATIONS
    // =========================

    match /notifications/{notificationId} {


      allow read: if isAdmin()
      ||
      (
        isLoggedIn()
        &&
        (
          resource.data.ownerId == request.auth.uid
          ||
          resource.data.buyerId == request.auth.uid
        )
      );


      allow create: if isLoggedIn();


      allow update: if isAdmin()
      ||
      (
        isLoggedIn()
        &&
        resource.data.ownerId == request.auth.uid
      );


      allow delete: if isAdmin();

    }





    
    // =========================
    // WISHLIST
    // =========================

    match /wishlist/{wishlistId} {

      allow read: if isLoggedIn()
      &&
      resource.data.buyerId == request.auth.uid;

      allow create: if isLoggedIn()
      &&
      request.auth.uid == request.resource.data.buyerId;

      allow delete: if isLoggedIn()
      &&
      resource.data.buyerId == request.auth.uid;

    }


    match /{document=**} {

      allow read, write: if false;

    }


  }

}
