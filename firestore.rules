rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =========================
    // AUTH HELPERS
    // =========================

    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isLoggedIn()
        && request.auth.token.role == "admin";
    }

    function isOwnerRole() {
      return isLoggedIn()
        &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role in [
          "property_owner",
          "hostel_owner",
          "pg_owner",
          "room_owner",
          "resale_seller"
        ];
    }

    function isDealer() {
      return isLoggedIn()
        &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "property_dealer";
    }

    function isTeamMember() {
      return isLoggedIn()
        &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "team_member";
    }


    // =========================
    // PROPERTIES
    // =========================

    match /properties/{propertyId} {

      // PUBLIC / PRIVATE PROPERTY READ
      // Public visitors may read approved listings only.
      // Admin may read every listing.
      // Owners, dealers and team members may read their own listings
      // regardless of approval status.
      allow read: if
        resource.data.get("status", "") == "approved"
        || isAdmin()
        || (
          isOwnerRole()
          && resource.data.get("ownerId", "") == request.auth.uid
        )
        || (
          isDealer()
          && resource.data.get("dealerId", "") == request.auth.uid
        )
        || (
          isTeamMember()
          && resource.data.get("addedByUid", "") == request.auth.uid
        );

      // ADMIN
      // Admin keeps full property control.
      allow create, update, delete: if isAdmin();

      // PROPERTY OWNER CREATE
      // Direct approval remains enabled.
      // Owner can create only under their own UID and cannot
      // inject dealer/team/admin routing or Featured metadata.
      allow create: if isOwnerRole()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == "approved"
        && request.resource.data.get("featured", false) == false
        && request.resource.data.get("dealerId", "") == ""
        && request.resource.data.get("role", "") == ""
        && request.resource.data.get("source", "") == ""
        && request.resource.data.get("addedByUid", "") == ""
        && request.resource.data.get("addedByRole", "") == ""
        && request.resource.data.get("contactHandlerUid", "") == ""
        && request.resource.data.get("contactHandlerEmail", "") == "";

      // DEALER CREATE
      // Direct approval remains enabled.
      // Dealer owns both routing IDs, cannot self-feature,
      // and cannot impersonate PropertyHub managed listings.
      allow create: if isDealer()
        && request.resource.data.dealerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.role == "property_dealer"
        && request.resource.data.status == "approved"
        && request.resource.data.get("featured", false) == false
        && request.resource.data.get("source", "") == ""
        && request.resource.data.get("addedByUid", "") == ""
        && request.resource.data.get("addedByRole", "") == ""
        && request.resource.data.get("contactHandlerUid", "") == ""
        && request.resource.data.get("contactHandlerEmail", "") == "";

      // TEAM CREATE
      // Team workflow remains pending for admin review.
      // PropertyHub routing must stay bound to the logged-in team member.
      allow create: if isTeamMember()
        && request.resource.data.addedByUid == request.auth.uid
        && request.resource.data.addedByRole == "team_member"
        && request.resource.data.source == "propertyhub_team"
        && request.resource.data.status == "pending"
        && request.resource.data.featured == false
        && request.resource.data.contactHandlerUid == request.auth.uid
        && request.resource.data.get("contactHandlerRole", "") == "team_member"
        && request.resource.data.get("dealerId", "") == "";

      // OWNER UPDATE
      // Normal property details may be edited, but ownership,
      // routing and privileged metadata cannot be changed.
      allow update: if isOwnerRole()
        && resource.data.ownerId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "ownerId",
          "dealerId",
          "role",
          "source",
          "addedByUid",
          "addedByRole",
          "contactHandlerUid",
          "contactHandlerEmail",
          "featured"
        ])
        && request.resource.data.status == "approved";

      // DEALER UPDATE
      // Dealer can edit normal listing details only.
      allow update: if isDealer()
        && resource.data.dealerId == request.auth.uid
        && resource.data.ownerId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "ownerId",
          "dealerId",
          "role",
          "source",
          "addedByUid",
          "addedByRole",
          "contactHandlerUid",
          "contactHandlerEmail",
          "featured",
          "status"
        ]);

      // OWNER / DEALER may remove only their own listing.
      allow delete: if isOwnerRole()
        && resource.data.ownerId == request.auth.uid;

      allow delete: if isDealer()
        && resource.data.dealerId == request.auth.uid
        && resource.data.ownerId == request.auth.uid;
    }


    // =========================
    // LEADS
    // =========================

    match /leads/{leadId} {

      // Logged-in customer may create only a lead
      // belonging to their own Firebase account.
      allow create: if isLoggedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.propertyId is string
        && request.resource.data.propertyId != ""
        && request.resource.data.status == "New"

        // The referenced property must actually exist.
        && exists(
          /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
        )

        // ownerId must match the real property contact handler.
        && (
          (
            get(
              /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
            ).data.get("source", "") in [
              "propertyhub_team",
              "propertyhub_admin"
            ]
            &&
            (
              request.resource.data.get("ownerId", "") ==
                get(
                  /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
                ).data.get("contactHandlerUid", "")
              ||
              (
                get(
                  /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
                ).data.get("contactHandlerUid", "") == ""
                &&
                request.resource.data.get("ownerId", "") ==
                  get(
                    /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
                  ).data.get("addedByUid", "")
              )
            )
          )
          ||
          (
            !(
              get(
                /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
              ).data.get("source", "") in [
                "propertyhub_team",
                "propertyhub_admin"
              ]
            )
            &&
            request.resource.data.get("ownerId", "") ==
              get(
                /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
              ).data.get("ownerId", "")
          )
        )

        // dealerId may be blank, otherwise it must match the property.
        && (
          request.resource.data.get("dealerId", "") == ""
          ||
          request.resource.data.get("dealerId", "") ==
            get(
              /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
            ).data.get("dealerId", "")
        );

      // Admin, assigned owner/team/dealer and the buyer
      // may read the lead.
      allow read: if isAdmin()
        ||
        (
          isLoggedIn()
          &&
          (
            resource.data.ownerId == request.auth.uid ||
            resource.data.buyerId == request.auth.uid
          )
        )
        ||
        (
          isDealer()
          && resource.data.dealerId == request.auth.uid
        );

      // Buyer cannot modify CRM/routing data.
      // Assigned owner/team/dealer can update CRM fields,
      // but cannot reassign the lead or buyer/property identity.
      allow update: if isAdmin()
        ||
        (
          isLoggedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.dealerId == resource.data.dealerId
          && request.resource.data.buyerId == resource.data.buyerId
          && request.resource.data.propertyId == resource.data.propertyId
        )
        ||
        (
          isDealer()
          && resource.data.dealerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.dealerId == resource.data.dealerId
          && request.resource.data.buyerId == resource.data.buyerId
          && request.resource.data.propertyId == resource.data.propertyId
        );

      allow delete: if isAdmin();
    }


    // =========================
    // SITE VISITS
    // =========================

    match /siteVisits/{visitId} {

      // Visit request must belong to the signed-in buyer.
      allow create: if isLoggedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.propertyId is string
        && request.resource.data.propertyId != ""
        && request.resource.data.status == "Pending"

        // The referenced property must actually exist.
        && exists(
          /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
        )

        // ownerId must match the real property contact handler.
        && (
          (
            get(
              /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
            ).data.get("source", "") in [
              "propertyhub_team",
              "propertyhub_admin"
            ]
            &&
            (
              request.resource.data.get("ownerId", "") ==
                get(
                  /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
                ).data.get("contactHandlerUid", "")
              ||
              (
                get(
                  /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
                ).data.get("contactHandlerUid", "") == ""
                &&
                request.resource.data.get("ownerId", "") ==
                  get(
                    /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
                  ).data.get("addedByUid", "")
              )
            )
          )
          ||
          (
            !(
              get(
                /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
              ).data.get("source", "") in [
                "propertyhub_team",
                "propertyhub_admin"
              ]
            )
            &&
            request.resource.data.get("ownerId", "") ==
              get(
                /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
              ).data.get("ownerId", "")
          )
        )

        // dealerId may be blank, otherwise it must match the property.
        && (
          request.resource.data.get("dealerId", "") == ""
          ||
          request.resource.data.get("dealerId", "") ==
            get(
              /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
            ).data.get("dealerId", "")
        );

      // Buyer can read their own request.
      // Assigned owner/team/dealer can also read it.
      allow read: if isAdmin()
        ||
        (
          isLoggedIn()
          &&
          (
            resource.data.ownerId == request.auth.uid ||
            resource.data.buyerId == request.auth.uid
          )
        )
        ||
        (
          isDealer()
          && resource.data.dealerId == request.auth.uid
        );

      // Only Admin or assigned business handler can update.
      // Routing and ownership fields remain immutable.
      allow update: if isAdmin()
        ||
        (
          isLoggedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.dealerId == resource.data.dealerId
          && request.resource.data.buyerId == resource.data.buyerId
          && request.resource.data.propertyId == resource.data.propertyId
        )
        ||
        (
          isDealer()
          && resource.data.dealerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.dealerId == resource.data.dealerId
          && request.resource.data.buyerId == resource.data.buyerId
          && request.resource.data.propertyId == resource.data.propertyId
        );

      allow delete: if isAdmin();
    }


    // =========================
    // PROPERTY VIEWS
    // =========================

    match /propertyViews/{viewId} {

      allow read: if true;

      allow create: if isLoggedIn()
        && request.resource.data.propertyId == viewId
        && request.resource.data.views == 1;

      allow update: if isLoggedIn()
        && resource.data.propertyId == viewId
        && request.resource.data.propertyId == resource.data.propertyId
        && request.resource.data.views == resource.data.views + 1;

      allow delete: if false;
    }


    // =========================
    // USERS
    // =========================

    match /users/{userId} {

      // User can read own profile.
      // Admin can read all profiles.
      allow read: if isAdmin()
        ||
        (
          isLoggedIn()
          && request.auth.uid == userId
        );

      // New users can create only their own profile.
      // Self-registration is limited to non-admin application roles.
      allow create: if isLoggedIn()
        && request.auth.uid == userId
        && request.resource.data.role in [
          "buyer",
          "property_owner",
          "hostel_owner",
          "pg_owner",
          "room_owner",
          "resale_seller",
          "property_dealer"
        ];

      // Admin can change anything.
      // Normal user can update own profile,
      // but CANNOT change their role.
      allow update: if isAdmin()
        ||
        (
          isLoggedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
        );

      allow delete: if isAdmin();

  // =========================
  // USER FAVORITES
  // =========================

  match /favorites/{propertyId} {

    allow read, create, delete: if isLoggedIn()
      && request.auth.uid == userId;
  }
    }


    // =========================
    // NOTIFICATIONS
    // =========================

    match /notifications/{notificationId} {

      // Only the intended recipient/business handler may read.
      allow read: if isAdmin()
        ||
        (
          isLoggedIn()
          &&
          (
            resource.data.ownerId == request.auth.uid ||
            resource.data.buyerId == request.auth.uid ||
            resource.data.dealerId == request.auth.uid
          )
        );

      // Admin may create any legitimate system notification.
      //
      // Customer-created property notifications:
      // sender must identify themselves as buyerId and provide
      // a real propertyId.
      //
      // Owner/team/dealer CRM notifications:
      // may only be created from the sender's own business account.
      allow create: if isAdmin()
        ||
        (
          isLoggedIn()
          && request.resource.data.buyerId == request.auth.uid
          && request.resource.data.propertyId is string
          && request.resource.data.propertyId != ""
          && exists(
            /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
          )

          // Notification must be routed to the real handler
          // stored on the referenced property.
          &&
          (
            (
              get(
                /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
              ).data.get("source", "") in [
                "propertyhub_team",
                "propertyhub_admin"
              ]
              &&
              (
                request.resource.data.ownerId ==
                  get(
                    /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
                  ).data.get("contactHandlerUid", "")
                ||
                request.resource.data.ownerId ==
                  get(
                    /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
                  ).data.get("addedByUid", "")
              )
            )
            ||
            (
              !(
                get(
                  /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
                ).data.get("source", "") in [
                  "propertyhub_team",
                  "propertyhub_admin"
                ]
              )
              &&
              request.resource.data.ownerId ==
                get(
                  /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
                ).data.get("ownerId", "")
            )
          )

          // If dealerId is supplied, it must match the property.
          &&
          (
            !("dealerId" in request.resource.data)
            ||
            request.resource.data.dealerId == ""
            ||
            request.resource.data.dealerId ==
              get(
                /databases/$(database)/documents/properties/$(request.resource.data.propertyId)
              ).data.get("dealerId", "")
          )
        )
        ||
        (
          isLoggedIn()
          && request.resource.data.ownerId == request.auth.uid
          && (
            isOwnerRole() ||
            isTeamMember()
          )
        )
        ||
        (
          isDealer()
          && request.resource.data.dealerId == request.auth.uid
        )
        ||
        (
          isLoggedIn()
          && request.resource.data.leadId is string
          && request.resource.data.leadId != ""
          && exists(
            /databases/$(database)/documents/leads/$(request.resource.data.leadId)
          )
          &&
          (
            get(
              /databases/$(database)/documents/leads/$(request.resource.data.leadId)
            ).data.get("ownerId", "") == request.auth.uid
            ||
            (
              isDealer()
              &&
              get(
                /databases/$(database)/documents/leads/$(request.resource.data.leadId)
              ).data.get("dealerId", "") == request.auth.uid
            )
          )
          &&
          request.resource.data.buyerId ==
            get(
              /databases/$(database)/documents/leads/$(request.resource.data.leadId)
            ).data.buyerId
        );

      // Recipient may only change notification state.
      // Routing/identity fields cannot be reassigned.
      allow update: if isAdmin()
        ||
        (
          isLoggedIn()
          &&
          (
            resource.data.ownerId == request.auth.uid ||
            resource.data.buyerId == request.auth.uid ||
            resource.data.dealerId == request.auth.uid
          )
          && request.resource.data
            .diff(resource.data)
            .affectedKeys()
            .hasOnly(["read"])
        );

      allow delete: if isAdmin();
    }


    // =========================
    // WISHLIST
    // =========================

    match /wishlist/{wishlistId} {

      allow read: if isLoggedIn()
        && resource.data.buyerId == request.auth.uid;

      allow create: if isLoggedIn()
        && request.auth.uid == request.resource.data.buyerId;

      allow delete: if isLoggedIn()
        && resource.data.buyerId == request.auth.uid;
    }


    // =========================
    // LOAN APPLICATIONS
    // =========================

    match /loanApplications/{applicationId} {

      // Customer can submit a new loan requirement.
      // Partner, sanction, disbursement and commission fields
      // are locked to their initial values at creation.
      allow create: if
        isLoggedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.status == "new"
        && request.resource.data.source == "propertyhub"
        && request.resource.data.partnerId == ""
        && request.resource.data.partnerName == ""
        && request.resource.data.externalApplicationId == ""
        && request.resource.data.sanctionedAmount == 0
        && request.resource.data.disbursedAmount == 0
        && request.resource.data.commissionPercent == 0
        && request.resource.data.commissionAmount == 0
        && request.resource.data.commissionStatus == "not_connected"
        && request.resource.data.consentAccepted == true
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 2
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() >= 10
        && request.resource.data.customerPhone.size() <= 15
        && request.resource.data.customerEmail is string
        && request.resource.data.customerEmail.size() <= 254
        && request.resource.data.requiredLoanAmount is number
        && request.resource.data.requiredLoanAmount > 0
        && request.resource.data.estimatedEligibleAmount is number
        && request.resource.data.estimatedEligibleAmount >= 0
        && request.resource.data.monthlyIncome is number
        && request.resource.data.monthlyIncome >= 0
        && request.resource.data.tenureYears is number
        && request.resource.data.tenureYears > 0
        && request.resource.data.estimatedEmi is number
        && request.resource.data.estimatedEmi >= 0;

      allow read: if isAdmin()
        ||
        (
          isLoggedIn()
          && resource.data.buyerId == request.auth.uid
        );

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    // =========================
    // HOMEPAGE SPONSORED ADS
    // =========================

    match /homepageAds/{adId} {

      // Public users may only read active campaigns.
      // Admin and PropertyHub team can manage all campaigns.
      allow read: if isAdmin()
        || isTeamMember()
        || resource.data.active == true;

      allow create, update, delete:
        if isAdmin() || isTeamMember();
    }


    // =========================
    // DEFAULT DENY
    // =========================

    
// =========================
// FAVORITES
// =========================


match /{document=**} {
      allow read, write: if false;
    }
  }
}
